# Omit OPENAI_API_KEY here when it is already set in your environment.
# OPENAI_API_KEY=your_api_key
OPENAI_MODEL=gpt-5-nano-2025-08-07
OPENAI_REASONING_EFFORT=low
OPENAI_SEARCH_MODEL=gpt-6.1-sol
OPENAI_SEARCH_REASONING_EFFORT=medium
OPENAI_PROMPT_CACHE_MODE=auto
OPENAI_MAX_CONCURRENT_EVALUATIONS=5

# Optional: the provider must support /responses and structured outputs.
# OPENAI_BASE_URL=https://your-provider.example/v1

# Comma-separated Apprise destinations for full-time notifications.
FT_APPRISE_URLS=https://discord.com/api/webhooks/...
